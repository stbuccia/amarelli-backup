[Unit]
Description=Liquorice backup device
After=local-fs.target

[Service]
Type=simple
User=raspberry
WorkingDirectory=/home/raspberry/liquorice-backup
Environment=PYTHONPATH=/home/raspberry/liquorice-backup/software
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/raspberry/liquorice-backup/.venv/bin/python /home/raspberry/liquorice-backup/software/main.py
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
