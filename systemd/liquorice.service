[Unit]
Description=Liquorice backup device
After=local-fs.target

[Service]
Type=simple
# User, WorkingDirectory, PYTHONPATH ed ExecStart vengono riscritti da
# install.sh con l'utente e la cartella reali del progetto.
# `systemctl cat liquorice` mostra il file installato.
User=root
# HOME non viene riscritto e deve restare la home dell'utente: config.json usa
# path con "~" per db, cache e log, e in /root si perderebbe lo storico.
Environment=HOME=/home/raspberry
WorkingDirectory=/home/raspberry/liquorice-backup
Environment=PYTHONPATH=/home/raspberry/liquorice-backup/software
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/raspberry/liquorice-backup/.venv/bin/python /home/raspberry/liquorice-backup/software/main.py
Restart=on-failure
RestartSec=5
# SIGINT invece di SIGTERM: lo stop passa dal KeyboardInterrupt di main.py, che
# spegne LED e display prima di uscire.
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
