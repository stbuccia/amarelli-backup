[Unit]
Description=Liquorice backup device
After=local-fs.target

[Service]
Type=simple
User=root
# HOME fissato alla home di raspberry: config.json usa path con "~" (db,
# cache, log) e devono continuare a risolvere in /home/raspberry/liquorice,
# non in /root, per non perdere lo storico e il database anti-duplicati.
Environment=HOME=/home/raspberry
WorkingDirectory=/home/raspberry/liquorice-backup
Environment=PYTHONPATH=/home/raspberry/liquorice-backup/software
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/raspberry/liquorice-backup/.venv/bin/python /home/raspberry/liquorice-backup/software/main.py
# Il servizio gira come root: serve per gestire l'access point WiFi via
# NetworkManager/nmcli (creare/attivare il profilo AP richiede privilegi che
# polkit non concede in modo affidabile a una sessione di systemd non
# interattiva, nemmeno con l'utente nel gruppo netdev) e per il montaggio
# della SD e il PWM della striscia LED, che altrimenti richiederebbero
# ciascuno la propria regola sudoers/capability separata.
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
