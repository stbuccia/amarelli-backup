[Unit]
Description=Liquorice backup device
After=local-fs.target

[Service]
Type=simple
# Il servizio gira come root e install.sh non riscrive questa riga: serve per il
# PWM/DMA della striscia LED (rpi_ws281x apre /dev/mem), per il profilo AP via
# NetworkManager/nmcli, che polkit non concede in modo affidabile a una sessione
# systemd non interattiva, e per il mount della SD.
User=root
# HOME viene riscritto da install.sh con la home dell'utente che installa:
# config.json usa path con "~" per db, cache e log, e in /root si perderebbe lo
# storico e il database anti-duplicati.
Environment=HOME=/home/raspberry
WorkingDirectory=/home/raspberry/liquorice-backup
Environment=PYTHONPATH=/home/raspberry/liquorice-backup/software
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/raspberry/liquorice-backup/.venv/bin/python /home/raspberry/liquorice-backup/software/main.py
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
